# ==============================================================================
# GAUNTLET CONFIGURATION
# ==============================================================================

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Providers (for Subject under evaluation, Referee evaluation & Saboteur attacks)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Fault Proxy Configuration
FAULT_PROXY_PORT=8080
FAULT_PROXY_HOST=127.0.0.1
FAULT_PROXY_LATENCY_MAX_MS=3000
FAULT_PROXY_FAILURE_RATE=0.25

# Gauntlet Execution Engine
DEFAULT_ROUNDS=5
DEFAULT_FAULT_BUDGET=3
TIMEOUT_SECONDS=45
SAFETY_STRICT_MODE=True

# Persistence & Storage
RUNS_DIR=./runs
EVIDENCE_DIR=./evidence
